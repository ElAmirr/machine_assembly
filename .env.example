# ============================================================
# Machine Assembly - configuration
# Copy this file to ".env" and edit the values.
# ============================================================

# Port used by the app server
PORT=4000

# ------------------------------------------------------------
# DATABASE FOLDER (JSON files live here)
# ------------------------------------------------------------
# Local folder of this PC:
#DATA_DIR=./data
#
# Shared network folder (UNC path) - any PC on the network can reach it:
#DATA_DIR=\\SERVER\MachineAssembly\data
#
# Mapped network drive:
#DATA_DIR=Z:\MachineAssembly\data
DATA_DIR=./data

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# CHANGE THIS to a long random text before first real use!
JWT_SECRET=change-me-to-a-long-random-secret-string
# How long a login stays valid (hours)
TOKEN_HOURS=24

# ------------------------------------------------------------
# Files / uploads
# ------------------------------------------------------------
# Max size of one uploaded file (MB)
MAX_UPLOAD_MB=50

# ------------------------------------------------------------
# Shared-folder safety options (multi-PC)
# ------------------------------------------------------------
# How long a write-lock may be held before it is considered abandoned (ms)
LOCK_STALE_MS=20000
# How many times the server retries to acquire a busy lock
LOCK_RETRIES=30
# Automatic backup of all JSON files (hours). 0 = only on startup.
BACKUP_INTERVAL_HOURS=24
# How many automatic backups to keep
BACKUP_KEEP=10

# App name shown in the UI
APP_NAME=Machine Assembly Manager
